<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1914">

    <WebView
        android:id="@+id/atlas_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0A1914" />

    <ProgressBar
        android:id="@+id/loading_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="100"
        android:indeterminate="false"
        android:progressTint="#C9A369"
        android:progressBackgroundTint="#123027" />

    <LinearLayout
        android:id="@+id/offline_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="#0A1914"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FIGURAMASTER"
            android:textColor="#D9B37C"
            android:textSize="30sp"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:layout_marginBottom="30dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connection_error"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:gravity="center"
            android:layout_marginBottom="12dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connection_help"
            android:textColor="#B8C5BF"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />
        <Button
            android:id="@+id/retry_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reload" />
        <Button
            android:id="@+id/browser_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_browser"
            android:layout_marginTop="10dp" />
    </LinearLayout>
</FrameLayout>
